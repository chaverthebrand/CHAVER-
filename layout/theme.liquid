<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.background_color | default: '#eee9df' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% liquid
    assign brand_name = settings.brand_name | default: shop.name
    assign seo_title = page_title
    unless seo_title contains brand_name
      assign seo_title = seo_title | append: ' — ' | append: brand_name
    endunless
    assign seo_description = page_description | default: settings.brand_statement

    case request.page_type
      when 'index'
        assign seo_title = 'CHAVÉR — Refined. Relaxed. Timeless.'
        assign seo_description = 'Discover CHAVÉR: refined, relaxed and timeless essentials built with patience and purpose. Explore the Foundations Collection, arriving Q1 2027.'
      when 'collection'
        if collection.handle == 'all'
          assign seo_title = 'Foundations Collection — CHAVÉR'
          assign seo_description = 'Explore the CHAVÉR Foundations Collection: six refined everyday essentials currently in development for the official Q1 2027 launch.'
        endif
      when 'search'
        assign seo_title = 'Search — CHAVÉR'
        assign seo_description = 'Search the CHAVÉR collection, Founder Story and CHAVÉR World.'
      when 'cart'
        assign seo_title = 'Pre-launch — CHAVÉR'
        assign seo_description = 'Ordering is closed while the CHAVÉR Foundations Collection is being developed for Q1 2027.'
    endcase

    if request.page_type == 'page'
      case page.handle
        when 'founder-story'
          assign seo_title = 'The Founder Story — CHAVÉR'
          assign seo_description = 'Read the story behind CHAVÉR, from the first idea by founder Chanan Dorff to the patient development of the Foundations Collection.'
        when 'chaver-world'
          assign seo_title = 'CHAVÉR World — Beyond the Clothes'
          assign seo_description = 'Step into CHAVÉR World: a perspective shaped by ambition, timeless design, architecture, travel and the freedom to build your own future.'
        when 'contact'
          assign seo_title = 'Contact — CHAVÉR'
          assign seo_description = 'Contact CHAVÉR with questions about the brand, the Foundations Collection or the Q1 2027 launch.'
        when 'customer-care'
          assign seo_title = 'Customer Care — CHAVÉR'
          assign seo_description = 'Read current pre-launch information about CHAVÉR products, care, shipping and customer support.'
        when 'size-guide'
          assign seo_title = 'Size Guide — CHAVÉR'
          assign seo_description = 'View the provisional CHAVÉR size guide while the Foundations Collection fits are being finalized.'
        when 'faq'
          assign seo_title = 'Frequently Asked Questions — CHAVÉR'
          assign seo_description = 'Find answers about CHAVÉR, the Foundations Collection, pre-launch access and the planned Q1 2027 release.'
      endcase
    endif
  %}
  <title>{{ seo_title | escape }}</title>
  {% if seo_description %}<meta name="description" content="{{ seo_description | strip_html | truncate: 160 | escape }}">{% endif %}
  {% if request.page_type == 'search' or request.page_type == 'cart' %}<meta name="robots" content="noindex,follow">{% endif %}
  <meta property="og:site_name" content="{{ settings.brand_name | default: shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  {% if seo_description %}<meta property="og:description" content="{{ seo_description | strip_html | truncate: 200 | escape }}">{% endif %}
  {% assign sharing_image = page_image | default: settings.social_sharing_image %}
  {% if sharing_image %}<meta property="og:image" content="https:{{ sharing_image | image_url: width: 1200 }}"><meta property="og:image:width" content="1200">{% endif %}
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ seo_title | escape }}">{% if seo_description %}<meta name="twitter:description" content="{{ seo_description | strip_html | truncate: 200 | escape }}">{% endif %}
  {% if settings.favicon != blank %}
    <link rel="icon" href="{{ settings.favicon | image_url: width: 64, height: 64 }}" type="image/png">
  {% else %}
    <link rel="icon" href="{{ 'chaver-favicon.svg' | asset_url }}" type="image/svg+xml" sizes="any">
  {% endif %}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":{{ settings.brand_name | default: shop.name | json }},"url":{{ shop.url | json }}{% if settings.logo != blank %},"logo":{{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{% endif %}}</script>
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":{{ settings.brand_name | default: shop.name | json }},"url":{{ shop.url | json }},"potentialAction":{"@type":"SearchAction","target":{{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},"query-input":"required name=search_term_string"}}</script>
  {{ content_for_header }}
  <style>
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-regular.woff' | asset_url }}') format('woff');font-style:normal;font-weight:400;font-display:swap}
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-bold.woff' | asset_url }}') format('woff');font-style:normal;font-weight:700 900;font-display:swap}
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-italic.woff' | asset_url }}') format('woff');font-style:italic;font-weight:400;font-display:swap}
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-bold-italic.woff' | asset_url }}') format('woff');font-style:italic;font-weight:700 900;font-display:swap}
    :root{--cream:{{ settings.background_color | default: '#eee9df' }};--ink:{{ settings.text_color | default: '#111111' }};--accent:{{ settings.accent_color | default: '#111111' }};--muted:{{ settings.muted_text_color | default: '#6f6a62' }};--line:{{ settings.border_color | default: '#cfc8bc' }};--font-brand:'CHAVER Sans','Helvetica Neue',Arial,sans-serif;}
  </style>
  {{ 'chaver.css' | asset_url | stylesheet_tag }}
  {{ 'chaver-enhancements.css' | asset_url | stylesheet_tag }}
  {{ 'chaver-brand.css' | asset_url | stylesheet_tag }}
</head>
<body class="{% if settings.prelaunch_mode %}is-prelaunch{% endif %}" data-prelaunch="{{ settings.prelaunch_mode }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  {% section 'announcement-bar' %}{% section 'header' %}
  <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'footer' %}{% section 'newsletter-popup' %}
  <script src="{{ 'chaver.js' | asset_url }}" defer></script>
</body>
</html>

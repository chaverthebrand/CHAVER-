<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.background_color | default: '#eee9df' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ settings.brand_name | default: shop.name }} — Coming {{ settings.launch_label }}</title>
  <meta name="description" content="{{ settings.brand_statement | escape }}">
  {% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64, height: 64 }}" type="image/png">{% endif %}
  {{ content_for_header }}
  <style>
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-regular.woff' | asset_url }}') format('woff');font-style:normal;font-weight:400;font-display:swap}
    @font-face{font-family:'CHAVER Sans';src:url('{{ 'chaver-sans-bold.woff' | asset_url }}') format('woff');font-style:normal;font-weight:700 900;font-display:swap}
    :root{--cream:{{ settings.background_color | default: '#eee9df' }};--ink:{{ settings.text_color | default: '#111111' }};--accent:{{ settings.accent_color | default: '#111111' }};--muted:{{ settings.muted_text_color | default: '#6f6a62' }};--line:{{ settings.border_color | default: '#cfc8bc' }};--font-brand:'CHAVER Sans','Helvetica Neue',Arial,sans-serif;}
  </style>
  {{ 'chaver.css' | asset_url | stylesheet_tag }}
  {{ 'chaver-brand.css' | asset_url | stylesheet_tag }}
  {{ 'chaver-password.css' | asset_url | stylesheet_tag }}
</head>
<body class="password-page">
  <a class="skip-link" href="#MainContent">Skip to content</a>
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
</body>
</html>

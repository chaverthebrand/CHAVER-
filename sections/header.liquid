<header class="site-header">
  <nav class="nav" aria-label="Primary navigation">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="{{ routes.all_products_collection_url }}">Collection</a>
    <a href="/pages/founder-story">Founder Story</a>
  </nav>

  {% assign logo_width = settings.logo_width | default: 140 %}
  <a class="brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }} home">
    {% if settings.logo != blank %}
      {% assign logo_height = logo_width | divided_by: settings.logo.aspect_ratio | round %}
      <img
        class="brand-logo"
        src="{{ settings.logo | image_url: width: 480 }}"
        srcset="{{ settings.logo | image_url: width: 160 }} 160w, {{ settings.logo | image_url: width: 240 }} 240w, {{ settings.logo | image_url: width: 320 }} 320w, {{ settings.logo | image_url: width: 480 }} 480w"
        sizes="{{ logo_width }}px"
        width="{{ logo_width }}"
        height="{{ logo_height }}"
        alt="{{ settings.brand_name | default: 'CHAVÉR' | escape }}"
      >
    {% else %}
      {{ settings.brand_name | default: 'CHAVÉR' }}
    {% endif %}
  </a>

  <nav class="nav right" aria-label="Secondary navigation">
    <a href="/pages/contact">Contact</a>
    <a href="{{ routes.search_url }}">Search</a>
    {% unless settings.prelaunch_mode %}<a href="{{ routes.cart_url }}">Bag</a>{% endunless %}
  </nav>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
</header>

<div class="mobile-menu" id="mobile-menu" hidden>
  <nav aria-label="Mobile navigation">
    <a href="{{ routes.root_url }}">Home</a>
    <a href="{{ routes.all_products_collection_url }}">Collection</a>
    <a href="/pages/founder-story">Founder Story</a>
    <a href="/pages/contact">Contact</a>
    <a href="{{ routes.search_url }}">Search</a>
    {% unless settings.prelaunch_mode %}<a href="{{ routes.cart_url }}">Bag</a>{% endunless %}
  </nav>
</div>

{% schema %}
{"name":"Header","settings":[]}
{% endschema %}

<section class="section"><div class="page-width contact-grid"><div><div class="eyebrow">Contact / CHAVÉR</div><h1 class="section-title">LET'S<br>CONNECT.</h1><p>Questions about CHAVÉR, the FOUNDATIONS COLLECTION or an upcoming release? Send us a message.</p></div><div>{% form 'contact' %}<label>Name</label><input class="field" type="text" name="contact[name]"><label>Email</label><input class="field" type="email" name="contact[email]" required><label>Message</label><textarea class="field" rows="7" name="contact[body]" required></textarea><button class="btn" type="submit">Send message</button>{% if form.posted_successfully? %}<p>Thank you. We'll be in touch soon.</p>{% endif %}{% endform %}</div></div></section>{% schema %}{"name":"CHAVER Contact","settings":[],"presets":[{"name":"CHAVER Contact"}]}{% endschema %}
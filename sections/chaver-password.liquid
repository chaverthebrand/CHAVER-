<section class="password-shell">
  <div class="password-visual" aria-hidden="true">
    <img src="{{ 'chaver-hero-foundations-4k.webp' | asset_url }}" width="2160" height="3840" alt="" fetchpriority="high">
  </div>
  <div class="password-panel">
    <a class="password-brand" href="{{ routes.root_url }}" aria-label="{{ settings.brand_name | default: shop.name | escape }} home">{{ settings.brand_name | default: 'CHAVÉR' }}</a>
    <div class="password-content">
      <div class="eyebrow">FOUNDATIONS COLLECTION / {{ settings.launch_label }}</div>
      <h1>BUILT WITH<br>INTENTION.</h1>
      <p class="password-statement">{{ settings.brand_statement }}</p>
      {% unless shop.password_message == blank %}<div class="password-message rte">{{ shop.password_message }}</div>{% endunless %}

      {% form 'customer', class: 'password-newsletter' %}
        <input type="hidden" name="contact[tags]" value="newsletter, password page">
        {% if form.posted_successfully? %}
          <p class="form-success" role="status">Thank you. You’re on the CHAVÉR list.</p>
        {% else %}
          {% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <label class="visually-hidden" for="PasswordNewsletterEmail">Email address</label>
          <div class="password-field">
            <input id="PasswordNewsletterEmail" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" placeholder="Email address" required>
            <button type="submit">JOIN</button>
          </div>
          <p class="microcopy">Join for collection development and launch updates. No orders are taken during pre-launch.</p>
          {% if shop.privacy_policy != blank %}<p class="microcopy"><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></p>{% endif %}
        {% endif %}
      {% endform %}

      <details class="password-access">
        <summary>Enter store password</summary>
        {% form 'storefront_password', class: 'password-login' %}
          {% if form.errors %}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <label for="StorefrontPassword">Password</label>
          <div class="password-field">
            <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
            <button type="submit">ENTER</button>
          </div>
        {% endform %}
      </details>
    </div>
    <div class="password-footer">REFINED. RELAXED. TIMELESS.</div>
  </div>
</section>

{% schema %}
{"name":"CHAVÉR password page","settings":[]}
{% endschema %}

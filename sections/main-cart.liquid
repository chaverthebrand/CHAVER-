<section class="section"><div class="page-width"><div class="eyebrow">Your bag</div><h1 class="section-title">Selected pieces.</h1>{% if cart.item_count == 0 %}<div class="empty-state"><p>Your bag is currently empty. The FOUNDATIONS COLLECTION is still in development and ordering is not open yet.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explore collection</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">{% for item in cart.items %}<div class="cart-row">{% if item.image %}<a href="{{ item.url }}" class="cart-image">{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy' }}</a>{% endif %}<div class="cart-copy"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}<p>{{ item.final_line_price | money }}</p><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" class="quantity-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div></div>{% endfor %}<div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="btn" type="submit" name="update">Update bag</button><div class="launch-note"><strong>ORDERING OPENS Q1 2027</strong><p>Checkout is intentionally disabled while we complete final samples, fit and quality approval.</p></div><a class="btn btn-solid" href="#chaver-newsletter">Join for early access</a></div></form>{% endif %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
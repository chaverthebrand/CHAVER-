<section class="section"><div class="page-width"><div class="eyebrow">Your bag</div><h1 class="section-title">Selected pieces.</h1>{% if cart.item_count == 0 %}<p>Your bag is currently empty.</p><a class="btn" href="{{ routes.all_products_collection_url }}">Explore collection</a>{% else %}<form action="{{ routes.cart_url }}" method="post" novalidate class="cart-form">{% for item in cart.items %}<div class="cart-row">{% if item.image %}<a href="{{ item.url }}" class="cart-image">{{ item.image | image_url: width: 400 | image_tag: loading: 'lazy' }}</a>{% endif %}<div class="cart-copy"><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title }}</p>{% endunless %}<p>{{ item.final_line_price | money }}</p><label for="updates_{{ item.key }}">Quantity</label><input id="updates_{{ item.key }}" class="quantity-input" type="number" name="updates[]" value="{{ item.quantity }}" min="0"></div></div>{% endfor %}<div class="cart-summary"><p>Subtotal <strong>{{ cart.total_price | money }}</strong></p><button class="btn" type="submit" name="update">Update bag</button><button class="btn btn-solid" type="submit" name="checkout">Checkout</button></div></form>{% endif %}</div></section>{% schema %}{"name":"Main cart","settings":[]}{% endschema %}
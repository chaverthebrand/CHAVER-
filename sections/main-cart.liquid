{{ 'chaver-cart.css' | asset_url | stylesheet_tag }}

<section class="prelaunch-cart section">
  <div class="page-width">
    <div class="prelaunch-cart-shell">
      <div class="prelaunch-cart-main">
        <div class="eyebrow">CHAVÉR / PRE-LAUNCH</div>
        <h1>ORDERING OPENS<br>Q1 2027.</h1>
        <p>
          The FOUNDATIONS COLLECTION is currently being refined. Prices and ordering remain unavailable until every final sample, fit and quality detail has been approved.
        </p>
        <div class="prelaunch-cart-actions">
          <a class="btn" href="{{ routes.all_products_collection_url }}">EXPLORE FOUNDATIONS</a>
          <a class="btn btn-solid" href="#chaver-newsletter">JOIN FOR EARLY ACCESS</a>
        </div>
      </div>

      <aside class="prelaunch-cart-status" aria-label="Collection launch status">
        <div class="prelaunch-status-row">
          <span>01</span>
          <div><strong>FOUNDATIONS COLLECTION</strong><p>Six premium everyday essentials.</p></div>
        </div>
        <div class="prelaunch-status-row">
          <span>02</span>
          <div><strong>DEVELOPMENT</strong><p>Final samples, fit and quality review.</p></div>
        </div>
        <div class="prelaunch-status-row">
          <span>03</span>
          <div><strong>LAUNCH</strong><p>Planned for Q1 2027.</p></div>
        </div>
      </aside>
    </div>
  </div>
</section>

{% schema %}
{"name":"Main cart","settings":[]}
{% endschema %}

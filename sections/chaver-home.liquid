<section class="hero hero--campaign">
  <div class="hero-media">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2400 | image_tag: class: 'hero-media-image', widths: '750, 1100, 1500, 2000, 2400', sizes: '(max-width: 800px) 100vw, 60vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.hero_alt }}
    {% else %}
      <img class="hero-media-image" src="{{ 'chaver-hero-foundations-4k.webp' | asset_url }}" width="2160" height="3840" alt="{{ section.settings.hero_alt | escape }}" fetchpriority="high">
    {% endif %}
  </div>
  <div class="hero-panel"><div class="hero-panel-inner">
    <div class="eyebrow">{{ settings.brand_name | default: 'CHAVÉR' }} / FOUNDATIONS COLLECTION</div>
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    <p class="hero-sub">{{ settings.brand_statement }}</p>
    <a class="btn hero-button" href="{{ routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
  </div></div>
</section>

<section class="section home-foundations"><div class="page-width">
  <div class="eyebrow">The Collection</div>
  <h2 class="section-title">{{ section.settings.collection_heading | newline_to_br }}</h2>
  <div class="home-product-grid" role="list">
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-tshirt.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Signature Heavyweight T-Shirt"><span><small>Signature Heavyweight T-Shirt</small></span></a>
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-longsleeve.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Signature Longsleeve"><span><small>Signature Longsleeve</small></span></a>
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-crewneck.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Signature Crewneck Sweater"><span><small>Signature Crewneck Sweater</small></span></a>
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-hoodie.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Signature Heavyweight Hoodie"><span><small>Signature Heavyweight Hoodie</small></span></a>
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-cap-studio.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Nylon 5-Panel Cap"><span><small>Nylon 5-Panel Cap</small></span></a>
    <a class="home-product-card" href="{{ routes.all_products_collection_url }}" role="listitem"><img src="{{ 'chaver-product-socks-studio.webp' | asset_url }}" width="800" height="1000" loading="lazy" alt="Premium Crew Socks"><span><small>Premium Crew Socks</small></span></a>
  </div>
  <div class="home-collection-action"><a class="btn" href="{{ routes.all_products_collection_url }}">View Foundations Collection</a></div>
</div></section>

<section class="section home-early-access"><div class="page-width home-early-access-inner">
  <div><div class="eyebrow">Newsletter</div><h2 class="section-title">FOLLOW THE<br>BUILD.</h2></div>
  <div><p>Sign up for the CHAVÉR newsletter to receive regular updates from the brand, including collection development, behind-the-scenes progress and launch news.</p><button class="btn btn-solid" type="button" data-newsletter-trigger>Join for early access</button><p class="microcopy">No orders are taken during pre-launch.</p></div>
</div></section>

{% schema %}
{"name":"CHAVER Home","settings":[{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"text","id":"hero_alt","label":"Hero image alt text","default":"Two CHAVÉR models wearing navy and black Foundations essentials"},{"type":"textarea","id":"heading","label":"Hero heading","default":"BUILT WITH\nINTENTION."},{"type":"text","id":"button_label","label":"Hero button","default":"Discover Foundations"}],"presets":[{"name":"CHAVER Home"}]}
{% endschema %}
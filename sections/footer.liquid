<footer class="footer">
  <div class="page-width footer-grid">
    <div>
      <div class="footer-brand">{{ settings.brand_name | default: 'CHAVÉR' }}</div>
      <p>{{ settings.brand_statement }}</p>
      <p class="microcopy">FOUNDATIONS COLLECTION — COMING {{ settings.launch_label }}</p>
    </div>
    <div>
      <div class="eyebrow">Explore</div>
      <p><a href="{{ routes.root_url }}">Home</a></p>
      <p><a href="{{ routes.all_products_collection_url }}">The Collection</a></p>
      <p><a href="/pages/founder-story">Founder Story</a></p>
      <p><a href="{{ routes.search_url }}">Search</a></p>
      {% if settings.instagram_url != blank %}<p><a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a></p>{% endif %}
      {% if settings.tiktok_url != blank %}<p><a href="{{ settings.tiktok_url }}" target="_blank" rel="noopener">TikTok</a></p>{% endif %}
    </div>
    <div>
      <div class="eyebrow">Customer care</div>
      <p><a href="/pages/size-guide">Size Guide</a></p>
      <p><a href="/pages/customer-care">Customer Care</a></p>
      <p><a href="/pages/contact">Contact</a></p>
    </div>
    <div>
      <div class="eyebrow">Legal</div>
      {% for policy in shop.policies %}
        {% if policy != blank %}<p><a href="{{ policy.url }}">{{ policy.title }}</a></p>{% endif %}
      {% endfor %}
    </div>
  </div>
  <div class="page-width footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ settings.brand_name | default: 'CHAVÉR' }}</span>
    <span>Built for the long term.</span>
  </div>
</footer>

{% schema %}
{"name":"Footer","settings":[]}
{% endschema %}

<section class="section"><div class="page-width product-page"><div class="product-gallery">{% for image in product.images %}<div class="product-media">{{ image | image_url: width: 1200 | image_tag: loading: 'lazy' }}</div>{% else %}<div class="product-media placeholder-product"><span>CHAVÉR</span></div>{% endfor %}</div><div class="product-info"><div class="eyebrow">FOUNDATIONS COLLECTION</div><h1>{{ product.title }}</h1><div class="product-price">{{ product.price | money }}</div><div class="product-description">{{ product.description }}</div><div class="launch-note"><strong>COMING Q1 2027</strong><p>This piece is currently in development. Ordering will open after final sample, fit and quality approval.</p></div><a class="btn" href="#chaver-newsletter">Join for early access</a></div></div></section>{% schema %}{"name":"Main product","settings":[]}{% endschema %}
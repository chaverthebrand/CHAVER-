<section class="section"><div class="page-width"><div class="eyebrow">Search</div><h1 class="section-title">Find your piece.</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><input class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search CHAVÉR"><button class="btn" type="submit">Search</button></form>{% if search.performed %}<div class="shop-grid search-results">{% for item in search.results %}<a class="shop-card" href="{{ item.url }}">{% if item.featured_image %}<div class="shop-image">{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}</div>{% endif %}<div class="shop-meta"><span>{{ item.title }}</span><span>{% if item.price %}{{ item.price | money }}{% else %}View{% endif %}</span></div></a>{% else %}<p>No results found for “{{ search.terms }}”.</p>{% endfor %}</div>{% endif %}</div></section>{% schema %}{"name":"Main search","settings":[]}{% endschema %}
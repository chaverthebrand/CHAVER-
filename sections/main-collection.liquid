<section class="section"><div class="page-width"><div class="eyebrow">FOUNDATIONS COLLECTION</div><h1 class="section-title">{{ collection.title | default: 'THE COLLECTION' }}</h1><div class="shop-grid">{% for product in collection.products %}<a class="shop-card" href="{{ product.url }}"><div class="shop-image">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}</div><div class="shop-meta"><span>{{ product.title }}</span><span>Coming soon</span></div></a>{% else %}{% assign names = 'Signature Heavyweight T-Shirt|Signature Longsleeve|Signature Crewneck Sweater|Signature Heavyweight Hoodie|Nylon 5-Panel Cap|Premium Crew Socks' | split: '|' %}{% for name in names %}<div class="shop-card"><div class="shop-image placeholder-product"><span>CHAVÉR</span></div><div class="shop-meta"><span>{{ name }}</span><span>Coming soon</span></div></div>{% endfor %}{% endfor %}</div></div></section>{% schema %}{"name":"Main collection","settings":[]}{% endschema %}
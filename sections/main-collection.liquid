{{ 'chaver-collection.css' | asset_url | stylesheet_tag }}

{% assign collection_items = 'Signature Heavyweight T-Shirt|t-shirt|chaver-product-tshirt.webp|A clean everyday T-shirt designed as the starting point of the CHAVÉR wardrobe.|Signature Longsleeve|longsleeve|chaver-product-longsleeve.webp|A refined long-sleeved essential built around a relaxed, understated silhouette.|Signature Crewneck Sweater|crewneck|chaver-product-crewneck.webp|A versatile crewneck created for quiet structure, comfort and everyday layering.|Signature Heavyweight Hoodie|hoodie|chaver-product-hoodie.webp|A considered hoodie with a clean profile and the relaxed direction of CHAVÉR.|Nylon 5-Panel Cap|cap|chaver-product-cap-studio.webp|A minimal five-panel cap designed to complete the Foundations wardrobe.|Premium Crew Socks|socks|chaver-product-socks-studio.webp|An understated everyday finishing piece developed for comfort and repeat wear.' | split: '|' %}

<section class="collection-showcase section" data-collection-showcase>
  <div class="page-width">
    <header class="collection-intro">
      <div class="eyebrow">CHAVÉR / FOUNDATIONS COLLECTION</div>
      <h1>THE FOUNDATIONS.</h1>
      <p>A first look at the six everyday essentials that form the beginning of CHAVÉR. We are currently developing the collection together with our suppliers and refining every piece before the official release. The Foundations Collection is planned to become available in {{ settings.launch_label }}.</p>
    </header>

    <div class="collection-showcase-grid" role="list">
      {% for item in collection_items %}
        {% assign item_index = forloop.index0 | modulo: 4 %}
        {% if item_index == 0 %}
          {% assign title_index = forloop.index0 %}
          {% assign handle_index = title_index | plus: 1 %}
          {% assign asset_index = title_index | plus: 2 %}
          {% assign detail_index = title_index | plus: 3 %}
          {% assign item_title = collection_items[title_index] %}
          {% assign item_handle = collection_items[handle_index] %}
          {% assign item_asset = collection_items[asset_index] %}
          {% assign item_detail = collection_items[detail_index] %}
          {% assign item_image = item_asset | asset_url %}

          <article class="collection-product" id="collection-{{ item_handle }}" role="listitem">
            <button
              class="collection-product-trigger"
              type="button"
              data-product-open
              data-product-title="{{ item_title | escape }}"
              data-product-detail="{{ item_detail | escape }}"
              data-product-image="{{ item_image }}"
              aria-label="View full image of {{ item_title | escape }}"
            >
              <span class="collection-product-media">
                <img
                  src="{{ item_image }}"
                  alt="{{ item_title | escape }} with embroidered CHAVÉR logo"
                  width="1600"
                  height="2000"
                  loading="{% if title_index < 6 %}eager{% else %}lazy{% endif %}"
                >
                <span class="collection-product-view" aria-hidden="true">VIEW FULL IMAGE</span>
              </span>
              <span class="collection-product-copy">
                <span class="collection-product-title">{{ item_title }}</span>
                <span class="collection-product-status">COMING {{ settings.launch_label }}</span>
              </span>
            </button>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="product-lightbox" data-product-lightbox hidden aria-hidden="true">
    <div class="product-lightbox-backdrop" data-product-close></div>
    <div class="product-lightbox-dialog" role="dialog" aria-modal="true" aria-labelledby="product-lightbox-title" tabindex="-1">
      <button class="product-lightbox-close" type="button" data-product-close aria-label="Close full product image">×</button>
      <div class="product-lightbox-media">
        <img data-product-lightbox-image alt="" width="1600" height="2000">
      </div>
      <div class="product-lightbox-copy">
        <div class="eyebrow">FOUNDATIONS COLLECTION</div>
        <h2 id="product-lightbox-title" data-product-lightbox-title></h2>
        <p data-product-lightbox-detail></p>
        <button class="btn btn-solid" type="button" data-newsletter-trigger>JOIN FOR EARLY ACCESS</button>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'chaver-collection.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Main collection",
  "settings": []
}
{% endschema %}
